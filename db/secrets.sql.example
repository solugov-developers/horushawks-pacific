-- ============================================================
-- Tokens de produção dos robôs Stone Profits.
-- Copie pra db/secrets.sql (gitignored) e preencha os valores reais.
-- Aplique APÓS db/003_more_scrapers.sql:
--   docker compose exec -T postgres psql -U scraper -d scrapers < db/secrets.sql
-- ============================================================

-- CRS Granite (Austin)
UPDATE scrapers SET vars = vars || jsonb_build_object(
  'auth_token', 'COLE_O_TOKEN_AQUI',
  'trimmed_user_id', 'random16'
) WHERE name = 'crs';

-- NSR Stone
UPDATE scrapers SET vars = vars || jsonb_build_object(
  'auth_token',     'COLE_O_TOKEN_AQUI',
  'trimmed_user_id', 'COLE_O_TRIMMED_USER_ID_AQUI'
) WHERE name = 'nsr';

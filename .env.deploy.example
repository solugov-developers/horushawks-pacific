# Config do deploy.sh — copie pra .env.deploy (gitignored).

# IP estático da instância Lightsail (output do Terraform)
INSTANCE_IP=203.0.113.42

# Caminho da chave SSH .pem (criada no console Lightsail)
SSH_KEY=$HOME/.ssh/horushawks-ssh.pem

# Domínio configurado no Caddy (deixar vazio = sem TLS, só IP)
APP_DOMAIN=app.seudominio.com
ADMIN_DOMAIN=admin.seudominio.com

# Email pra cert do Let's Encrypt
EMAIL=voce@seudominio.com

# Hash gerado por `caddy hash-password --plaintext "sua-senha"` (rodar na instância)
ADMIN_BASIC_HASH=$2a$14$xxxxxxxxxxxxxxxxxxxxxxxx

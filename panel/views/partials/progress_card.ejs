<% function fmtDate(d) { return d ? new Date(d).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'medium' }) : '—'; } %>
<% const pct = runningJob.progress_total ? Math.round((runningJob.progress_done / runningJob.progress_total) * 100) : null; %>
<div id="progress-slot" hx-get="/scrapers/<%= runningJob.scraper_id %>/progress" hx-trigger="every 2s" hx-swap="outerHTML">
  <div class="card p-5 mb-6 relative overflow-hidden grain">
    <div class="veining absolute inset-0 opacity-60"></div>
    <div class="relative">
      <div class="flex items-start justify-between gap-4 mb-3">
        <div>
          <p class="text-[11px] uppercase tracking-[0.18em] text-bronze-600 font-medium mb-1">Em execução</p>
          <h3 class="font-serif text-2xl font-semibold leading-tight">Job #<%= runningJob.id %> — coletando inventário</h3>
          <p class="text-xs text-stone-500 mt-1 tabular">
            iniciado <%= fmtDate(runningJob.started_at) %>
            <% if (runningJob.progress_label) { %> · <span class="text-stone-700"><%= runningJob.progress_label %></span><% } %>
          </p>
        </div>
        <div class="text-right shrink-0">
          <% if (pct != null) { %>
            <div class="font-serif text-3xl font-semibold tabular leading-none"><%= pct %>%</div>
            <div class="text-[11px] text-stone-500 mt-1 tabular"><%= runningJob.progress_done.toLocaleString('pt-BR') %> / <%= runningJob.progress_total.toLocaleString('pt-BR') %></div>
          <% } else { %>
            <div class="font-serif text-2xl font-semibold text-bronze-600 leading-none">…</div>
            <div class="text-[11px] text-stone-500 mt-1">preparando</div>
          <% } %>
        </div>
      </div>
      <div class="h-2 rounded-full bg-stone-200 overflow-hidden relative">
        <% if (pct != null) { %>
          <div class="h-full bg-gradient-to-r from-bronze-500 to-bronze-300 transition-all duration-500" style="width: <%= pct %>%"></div>
        <% } else { %>
          <div class="h-full w-1/3 bg-gradient-to-r from-bronze-500 to-bronze-300 animate-pulse" style="animation-duration: 1.5s"></div>
        <% } %>
      </div>
      <p class="text-[11px] text-stone-500 mt-3 inline-flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-bronze-500 animate-pulse"></span> atualizando ao vivo
      </p>
    </div>
  </div>
</div>

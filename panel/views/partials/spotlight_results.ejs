<% if (!scrapers.length && !jobs.length && !slabs.length) { %>
  <div class="p-8 text-center text-sm text-stone-500">Nada encontrado.</div>
<% } else { %>
  <div class="py-2">
    <% if (scrapers.length) { %>
      <div class="px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-500">Robôs</div>
      <% scrapers.forEach(s => { %>
        <a href="/scrapers/<%= s.id %>/results" class="flex items-center gap-3 px-4 py-2.5 hover:bg-stone-100 transition-colors">
          <i data-lucide="cpu" class="text-stone-500"></i>
          <div class="flex-1 min-w-0">
            <div class="text-sm text-stone-900 font-medium truncate"><%= s.name %></div>
            <% if (s.description) { %><div class="text-xs text-stone-500 truncate"><%= s.description %></div><% } %>
          </div>
          <span class="kbd">↵</span>
        </a>
      <% }) %>
    <% } %>
    <% if (jobs.length) { %>
      <div class="px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-500 mt-1">Execuções</div>
      <% jobs.forEach(j => { %>
        <a href="/scrapers/<%= j.scraper_id || '' %>/results" class="flex items-center gap-3 px-4 py-2.5 hover:bg-stone-100 transition-colors">
          <i data-lucide="activity" class="text-stone-500"></i>
          <div class="flex-1 min-w-0">
            <div class="text-sm text-stone-900 truncate"><%= j.scraper_name %> · job #<%= j.id %></div>
            <div class="text-xs text-stone-500 truncate"><%= j.status %></div>
          </div>
        </a>
      <% }) %>
    <% } %>
    <% if (slabs.length) { %>
      <div class="px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-500 mt-1">Inventário (encore)</div>
      <% slabs.forEach(s => { %>
        <a href="/data?table=encore_slabs&q=<%= encodeURIComponent(s.serial_number || s.item_name || '') %>" class="flex items-center gap-3 px-4 py-2.5 hover:bg-stone-100 transition-colors">
          <i data-lucide="layers" class="text-stone-500"></i>
          <div class="flex-1 min-w-0">
            <div class="text-sm text-stone-900 truncate"><%= s.item_name %></div>
            <div class="text-xs text-stone-500 truncate"><%= s.serial_number || '' %><% if (s.color) { %> · <%= s.color %><% } %></div>
          </div>
        </a>
      <% }) %>
    <% } %>
  </div>
<% } %>

<%- include('_header', { eyebrow: 'Plataforma', title: 'Webhooks', subtitle: 'POST automático ao concluir ou falhar coletas', currentPath: '/webhooks' }) %>

<% function fmtDate(d) { return d ? new Date(d).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : '—'; } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <!-- Form criar -->
  <div class="card p-6 lg:col-span-1 self-start">
    <h3 class="font-serif text-lg font-semibold mb-3">Novo webhook</h3>
    <form action="/webhooks" method="post" class="space-y-3">
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-stone-500 mb-1.5">URL</label>
        <input type="url" name="url" required placeholder="https://hooks.slack.com/..." class="w-full rounded-lg bg-white border border-stone-300/80 px-3.5 py-2 text-sm focus:outline-none focus:border-bronze-500 focus:ring-2 focus:ring-bronze-500/20 mono">
      </div>
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-stone-500 mb-1.5">Robô (opcional)</label>
        <select name="scraper_id" class="w-full rounded-lg bg-white border border-stone-300/80 px-3 py-2 text-sm focus:outline-none focus:border-bronze-500 focus:ring-2 focus:ring-bronze-500/20">
          <option value="">Todos</option>
          <% scrapers.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-stone-500 mb-1.5">Eventos</label>
        <input type="text" name="events" value="job.done,job.failed" class="w-full rounded-lg bg-white border border-stone-300/80 px-3.5 py-2 text-sm focus:outline-none focus:border-bronze-500 focus:ring-2 focus:ring-bronze-500/20 mono">
      </div>
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-stone-500 mb-1.5">Secret (opcional)</label>
        <input type="text" name="secret" placeholder="header X-HorusHawks-Secret" class="w-full rounded-lg bg-white border border-stone-300/80 px-3.5 py-2 text-sm focus:outline-none focus:border-bronze-500 focus:ring-2 focus:ring-bronze-500/20 mono">
      </div>
      <button type="submit" class="w-full rounded-lg btn-primary px-3 py-2 text-sm font-medium inline-flex items-center justify-center gap-2">
        <i data-lucide="plus" class="!w-4 !h-4"></i> Criar
      </button>
    </form>

    <div class="mt-6 pt-5 border-t divider text-xs text-stone-500 space-y-1.5">
      <p class="font-medium text-stone-700">Payload enviado:</p>
      <code class="block mono text-[11px] bg-stone-50 p-2 rounded">{
  "event": "job.done",
  "payload": { ... },
  "sent_at": "..."
}</code>
    </div>
  </div>

  <!-- Lista -->
  <div class="card overflow-hidden lg:col-span-2">
    <div class="px-6 py-4 border-b divider">
      <h3 class="font-serif text-lg font-semibold">Webhooks configurados</h3>
    </div>
    <ul class="divide-y divider">
      <% if (!webhooks.length) { %>
        <li class="px-6 py-10 text-center text-stone-500">Nenhum webhook ainda.</li>
      <% } %>
      <% webhooks.forEach(w => { %>
        <li class="px-6 py-4 flex items-start gap-3">
          <i data-lucide="webhook" class="text-stone-500 mt-0.5"></i>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-stone-900 mono break-all"><%= w.url %></p>
            <p class="text-[11px] text-stone-500 mt-1">
              <%= w.scraper_name || 'todos os robôs' %>
              · eventos: <code class="mono"><%= (w.events || []).join(', ') %></code>
              <% if (w.last_status) { %>
                · último: <span class="<%= w.last_status >= 200 && w.last_status < 300 ? 'text-sage-700' : 'text-terra-700' %>">HTTP <%= w.last_status %></span>
                <%= fmtDate(w.last_delivered_at) %>
              <% } %>
            </p>
          </div>
          <form action="/webhooks/<%= w.id %>/delete" method="post" onsubmit="return confirm('Remover webhook?')">
            <button type="submit" class="inline-flex items-center gap-1 rounded-md border border-terra-500/30 bg-terra-50 text-terra-700 hover:bg-terra-500/15 px-2.5 py-1 text-xs">
              <i data-lucide="trash-2" class="!w-3 !h-3"></i>
            </button>
          </form>
        </li>
      <% }) %>
    </ul>
  </div>
</div>

<%- include('_footer') %>

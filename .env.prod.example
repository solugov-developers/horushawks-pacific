# ============================================================
# .env de produção — copia pra .env.prod (gitignored).
# Gere senhas com: openssl rand -base64 32
# Gere AUTH_SECRET com: openssl rand -hex 64
# ============================================================

# Postgres
POSTGRES_USER=scraper
POSTGRES_PASSWORD=GERAR_COM_OPENSSL_RAND_BASE64_32
POSTGRES_DB=scrapers

# Painel EJS (admin interno)
PANEL_USER=admin
PANEL_PASSWORD=GERAR_COM_OPENSSL_RAND_BASE64_24
# Token Bearer que o web usa p/ disparar runs via /api/v1 (senão o botão "run" quebra).
# Gerar um token no painel (/api-tokens) ou 'hh_'+openssl rand -base64 24, e inserir o hash em api_tokens.
PANEL_API_TOKEN=hh_GERAR_E_REGISTRAR_EM_api_tokens

# Sessões (Express + JWT do Next.js)
SESSION_SECRET=GERAR_COM_OPENSSL_RAND_HEX_64
AUTH_SECRET=GERAR_COM_OPENSSL_RAND_HEX_64

# Portas
PANEL_PORT=3001
WORKER_CONCURRENCY=1
JOB_ATTEMPTS=3

# Production marker (consumed by panel/server.js fail-fast)
NODE_ENV=production
